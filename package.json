{
    "name": "@blueprintsfi/blueprints.js",
    "version": "2.0.0-dev",
    "description": "Free and open-source TypeScript library for working with Blueprints",
    "keywords": ["defi", "evm"],
    "homepage": "https://blueprints.finance/",
    "bugs": {
        "url": "https://github.com/blueprintsfi/blueprints.js/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/blueprintsfi/blueprints.js.git"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/blueprints.d.ts",
            "default": "./dist/blueprints.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/blueprints.js",
    "types": "./dist/blueprints.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepack": "npm run typecheck && npm run build"
    },
    "dependencies": {
        "@noble/hashes": "^2.0.1"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^5.1.0",
        "typescript": "^7",
        "vitest": "^5.1.0"
    },
    "publishConfig": {
        "access": "public"
    }
}

{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "lib": ["ESNext", "DOM"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": false,
        "noEmitOnError": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "./src",
        "outDir": "./dist/types",
        "types": []
    },
    "include": ["src/**/*.ts"]
}
